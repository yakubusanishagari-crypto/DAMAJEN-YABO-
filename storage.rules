rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Constituency public media: read-all, write-authenticated (admins/staff)
    match /constituency/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Applicant sensitive documents: private, restricted to authenticated owner or admin
    match /applications/{applicantId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
