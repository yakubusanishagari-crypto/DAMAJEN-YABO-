{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Constituency development project record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "location": { "type": "string", "maxLength": 150 },
        "status": { "type": "string" },
        "description": { "type": "string", "maxLength": 5000 },
        "startDate": { "type": "string" },
        "completionDate": { "type": "string" },
        "expenditure": { "type": "string" },
        "contractor": { "type": "string" },
        "images": { "type": "array" },
        "date": { "type": "string" }
      },
      "required": ["id", "title", "category", "location", "status", "description"]
    },
    "NewsArticle": {
      "title": "NewsArticle",
      "description": "News article or press release",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "excerpt": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 10000 },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "imageUrl": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array" }
      },
      "required": ["id", "title", "content", "category", "date", "imageUrl"]
    },
    "EmpowermentProgram": {
      "title": "EmpowermentProgram",
      "description": "Empowerment program offering grants or support",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "eligibility": { "type": "string" },
        "targetBeneficiaries": { "type": "string" },
        "startDate": { "type": "string" },
        "deadline": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "array" }
      },
      "required": ["id", "title", "category", "deadline", "status"]
    },
    "LegislativeRecord": {
      "title": "LegislativeRecord",
      "description": "Legislative bill, motion, or committee report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 250 },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "title", "category", "status", "date"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Photo or video gallery media item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "title", "imageUrl", "date"]
    },
    "ContactSubmission": {
      "title": "ContactSubmission",
      "description": "Citizen inquiry or message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string", "maxLength": 2000 },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "email", "message", "date"]
    },
    "ProgramApplication": {
      "title": "ProgramApplication",
      "description": "Constituent application for empowerment grant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "programId": { "type": "string" },
        "programTitle": { "type": "string" },
        "applicantName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "wardOrTown": { "type": "string" },
        "qualifications": { "type": "string" },
        "statement": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "referenceNumber", "programId", "applicantName", "email", "phone", "status"]
    },
    "TownHallPoll": {
      "title": "TownHallPoll",
      "description": "Town hall poll or voting session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "question", "options"]
    },
    "CommunityPetition": {
      "title": "CommunityPetition",
      "description": "Community grievance or petition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "title": { "type": "string" },
        "petitionerName": { "type": "string" },
        "ward": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "referenceNumber", "title", "petitionerName", "ward", "description", "status"]
    },
    "ConstituencyOffice": {
      "title": "ConstituencyOffice",
      "description": "Constituency ward office",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "email", "name", "role"]
    }
  },
  "firestore": {
    "projects/{projectId}": {
      "schema": "Project",
      "description": "Development projects collection"
    },
    "news/{newsId}": {
      "schema": "NewsArticle",
      "description": "News articles collection"
    },
    "programs/{programId}": {
      "schema": "EmpowermentProgram",
      "description": "Empowerment programs collection"
    },
    "legislative/{recordId}": {
      "schema": "LegislativeRecord",
      "description": "Legislative records collection"
    },
    "gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Gallery media collection"
    },
    "contacts/{contactId}": {
      "schema": "ContactSubmission",
      "description": "Contact submissions collection"
    },
    "applications/{appId}": {
      "schema": "ProgramApplication",
      "description": "Empowerment grant applications collection"
    },
    "polls/{pollId}": {
      "schema": "TownHallPoll",
      "description": "Town hall polls collection"
    },
    "petitions/{petitionId}": {
      "schema": "CommunityPetition",
      "description": "Community petitions collection"
    },
    "offices/{officeId}": {
      "schema": "ConstituencyOffice",
      "description": "Constituency offices collection"
    },
    "adminUsers/{userId}": {
      "schema": "AdminUser",
      "description": "Admin users collection"
    }
  }
}
